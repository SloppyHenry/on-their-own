# Kopie als deploy/.env anlegen (steht in .gitignore). Alles ist optional.

# Port, unter dem die App im Heimnetz erreichbar ist: http://maintux:8090
SIM_PUBLISH=8090

# Zugangsschutz: leer = aus (Heimnetz). Mit Wert fragt die Oberfläche einmal nach dem Token.
# Erzeugen z. B. mit: openssl rand -base64 24
SIM_ACCESS_TOKEN=

# Router mit dem Modell auf dem Host (bleibt wie er ist). Lauscht der Router nur an der LAN-Adresse des Hosts
# (llama-server --host 192.168.x.y), die Adresse selbst eintragen, z. B. http://192.168.1.20:8080/v1
SIM_LLM_BASE_URL=http://host.docker.internal:8080/v1

# Modellkennung, wie sie der Router unter /v1/models meldet (Standard: qwen3.8-9b-uncensored)
# SIM_LLM_MODEL=qwen3.8-9b

# Datei mit dem API-Schlüssel des Routers. deploy_maintux.sh legt daraus eine lesbare Kopie in ~/on-their-own-secrets/ an
# und setzt diese Variable selbst; nur von Hand ändern, wenn du docker compose direkt aufrufst.
# SIM_KEY_FILE=/home/<benutzer>/on-their-own-secrets/llm_api_key

# Simulation beim Start des Containers sofort laufen lassen (false = pausiert warten)
SIM_AUTOSTART=false
